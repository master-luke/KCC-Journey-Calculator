{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "strict": true,
    "noEmitOnError": true,
    "jsx": "react",
    "jsxFactory": "h",
    "rootDir": "src",
    "outDir": "dist",
    "types": []
  },
  "include": [
    "src"
  ]
}
